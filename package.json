{
  "name": "blogs-are-back-extension",
  "version": "1.7.1",
  "description": "Browser extension for fetching RSS/Atom feeds for Blogs Are Back",
  "type": "module",
  "scripts": {
    "dev": "BROWSER=chrome vite build --watch --mode development",
    "dev:firefox": "BROWSER=firefox vite build --watch --mode development",
    "build": "npm run build:chrome",
    "build:chrome": "tsc && BROWSER=chrome vite build",
    "build:firefox": "tsc && BROWSER=firefox vite build",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "package:chrome": "npm run build:chrome && cd dist/chrome && zip -r ../../blogs-are-back-chrome.zip .",
    "package:firefox": "npm run build:firefox && cd dist/firefox && zip -r ../../blogs-are-back-firefox.zip .",
    "package:all": "npm run package:chrome && npm run package:firefox",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "linkedom": "^0.18.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "@types/chrome": "^0.0.268",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "^0.12.4",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "prettier": {
    "arrowParens": "always",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "semi": true
  }
}
