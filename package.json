{
  "name": "blogs-are-back-extension",
  "version": "2.1.10",
  "description": "Browser extension for fetching RSS/Atom feeds for Blogs Are Back",
  "type": "module",
  "scripts": {
    "dev": "BROWSER=chrome vite build --watch --mode development",
    "dev:firefox": "BROWSER=firefox vite build --watch --mode development",
    "build": "npm run build:chrome",
    "build:chrome": "tsc && BROWSER=chrome vite build --mode development",
    "build:firefox": "tsc && BROWSER=firefox vite build --mode development",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "build:prod:chrome": "tsc && BROWSER=chrome vite build",
    "build:prod:firefox": "tsc && BROWSER=firefox vite build",
    "build:prod:all": "npm run build:prod:chrome && npm run build:prod:firefox",
    "package:chrome": "npm run build:prod:chrome && cd dist/chrome && zip -r ../../blogs-are-back-chrome.zip .",
    "package:firefox": "npm run build:prod:firefox && cd dist/firefox && zip -r ../../blogs-are-back-firefox.zip .",
    "package:all": "npm run package:chrome && npm run package:firefox",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "firefox:run": "web-ext run -s dist/firefox",
    "firefox:run:profile": "web-ext run -s dist/firefox --firefox-profile default-release --keep-profile-changes",
    "firefox:lint": "web-ext lint -s dist/firefox"
  },
  "dependencies": {
    "@fontsource/merriweather": "^5.2.11",
    "@mozilla/readability": "^0.5.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/chrome": "^0.0.268",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "^0.12.4",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.24",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "web-ext": "^8.4.0"
  },
  "prettier": {
    "arrowParens": "always",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "semi": true
  }
}
